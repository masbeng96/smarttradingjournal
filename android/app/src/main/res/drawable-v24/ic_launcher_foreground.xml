<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Rounded Accent Ring -->
    <path
        android:pathData="M32,24 L76,24 A8,8 0 0,1 84,32 L84,76 A8,8 0 0,1 76,84 L32,84 A8,8 0 0,1 24,76 L24,32 A8,8 0 0,1 32,24 Z"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="24"
                android:endX="84"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#10B981" />
                <item android:offset="1.0" android:color="#06B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upward Trending Compound Line Chart -->
    <path
        android:pathData="M32,70 L48,53 L58,62 L76,36"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="70"
                android:endX="76"
                android:endY="36"
                android:type="linear">
                <item android:offset="0.0" android:color="#10B981" />
                <item android:offset="1.0" android:color="#06B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Target Node Circle -->
    <path
        android:pathData="M76,36 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#10B981" />

    <!-- Arrow Head -->
    <path
        android:pathData="M64,36 L76,36 L76,48"
        android:fillColor="#00000000"
        android:strokeColor="#10B981"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
